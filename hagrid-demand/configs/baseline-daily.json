{
  "schema_version": 1,
  "rng_version": 1,
  "seed": 42,
  "input_dir": "../../parcel-demand-estimation/input",
  "output_dir": "../runs",
  "source_mode": "raw",
  "sources": [
    {
      "id": "H01",
      "file": "persons_total.csv",
      "adapter": "persons",
      "kind": "synthetic_or_derived_unconfirmed",
      "year": null,
      "unit": "person",
      "role": "structure"
    },
    {
      "id": "H02",
      "file": "companies_Total_reduced.shp",
      "adapter": "companies",
      "kind": "unconfirmed",
      "year": null,
      "unit": "establishment",
      "role": "structure"
    },
    {
      "id": "H03",
      "file": "dhl2streets_2021.shp",
      "adapter": "dhl",
      "kind": "reported_observation",
      "year": 2021,
      "unit": "unconfirmed_daily_mean",
      "role": "reference_anchor"
    },
    {
      "id": "H04",
      "file": "Hermes_PLZ-Menge_2019-2021.csv",
      "adapter": "hermes",
      "kind": "reported_observation",
      "year": null,
      "unit": "unconfirmed",
      "role": "inventory_only"
    },
    {
      "id": "H06",
      "file": "plz_region_hannover.csv",
      "adapter": "plz",
      "kind": "geometry",
      "year": null,
      "unit": "postal_area",
      "role": "support"
    }
  ],
  "weekly_source": "../../parcel-demand-estimation/input/Parcels19_20_21_inter.xlsx",
  "reference_year": 2021,
  "reference_operating_days": "calendar",
  "output_scope": "daily",
  "legacy_export": false,
  "persons_crs": "EPSG:25832",
  "plz_crs": "EPSG:25832",
  "target_crs": "EPSG:25832",
  "dhl_exclude_above": 1000,
  "assumptions": [
    "DHL tagesschni is treated as a documented reference anchor pending measurement-definition review.",
    "Hermes rows are inventory only and do not anchor the reference level.",
    "Same eight simulation days as ParcelDemandScenarioGenerator (Fri/Sat of ISO week 19 and Mon-Sat of ISO week 20, 2025).",
    "DHL tagesschni is the mean per delivery day of 2021 under the configured calendar (Sundays and Lower Saxony holidays closed).",
    "Demand locations are OSM buildings (Geofabrik Niedersachsen 2021-01-01, (c) OpenStreetMap contributors, ODbL)."
  ],
  "years": [
    2025
  ],
  "dates": [
    "2025-05-09",
    "2025-05-10",
    "2025-05-12",
    "2025-05-13",
    "2025-05-14",
    "2025-05-15",
    "2025-05-16",
    "2025-05-17"
  ],
  "calendar": {
    "weekly_profile": "source",
    "holiday_region": "NI",
    "holiday_factor": 0.0
  },
  "temporal": {
    "mode": "shipping_transit",
    "shipping_weekday_weights": {
      "private": "standard",
      "business": "standard"
    },
    "transit_days": {
      "default": [
        0.85,
        0.13,
        0.02
      ]
    },
    "saturday_delivery": {
      "default": 1.0
    },
    "business_saturday_open": 0.2,
    "week_log_sd": 0.016,
    "week_ar": 0.5,
    "carrier_week_log_sd": 0.02,
    "carrier_day_log_sd": 0.03,
    "weekday_concentration": 1000,
    "christmas_pull_forward_days": 5,
    "holiday_spread_days": 3,
    "events": "standard",
    "half_delivery_days": {
      "12-24": 0.5,
      "12-31": 0.5
    }
  },
  "business_potential": {
    "model": "company_locations"
  },
  "spatial": {
    "mode": "dirichlet",
    "between": 50000.0,
    "within_per_site": 40.0,
    "carrier_plz_log_sd": 0.0,
    "site_frailty_cv": 0.5
  },
  "matsim_export": true,
  "osm_buildings": "../../parcel-demand-estimation/input/osm/osm_buildings_region_hannover_2021.parquet",
  "osm_points": "../../parcel-demand-estimation/input/osm/osm_address_poi_region_hannover_2021.parquet",
  "osm_parcel_points": "../../parcel-demand-estimation/input/osm/osm_parcel_points_region_hannover.parquet",
  "out_of_home": {"enabled": true, "synthetic_lockers": {"Amazon": 22}},
  "anchor": {
    "mode": "street",
    "level_correction": {
      "min_persons": 30,
      "min_streets": 20,
      "upper": 2.0,
      "lower": 0.5
    },
    "gap_threshold": 5.0
  },
  "buildings": {
    "residential_max_distance_m": 65,
    "firm_candidate_distance_m": 100,
    "firm_fallback_distance_m": 250,
    "match_distance_m": 100,
    "extended_match_distance_m": 250
  },
  "stops": {
    "walking_radius_m": 40,
    "own_stop_parcels_per_day": 15,
    "max_parcels_per_row": 400,
    "section_length_m": 50
  },
  "notebook_output_dir": "../../parcel-demand-estimation/output"
}
