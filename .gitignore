# Maven build directory
target/

# IDE files
.idea/
*.iml
*.ipr
*.iws

# Compiled class files
*.class

# Package files
*.jar
*.war
*.ear

# Maven specific files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# Logs
log/
*.log
*.log.[0-9]*

# Exclude specific large files
hagrid/demand/estimation/Project USEfUL XT/Verflechtungsprognose2030/ketten-2010.csv
hagrid/demand/estimation/Project USEfUL XT/Verflechtungsprognose2030/ketten-2030.csv
hagrid/demand/estimation/Project USEfUL XT/hochrechnung_kommentiert.py
hagrid/demand/estimation/input/
hagrid/demand/estimation/output/

# hagrid/demand/estimation-batch: only track notebooks (.ipynb) and folder structure of input/output (via .gitkeep)
hagrid/demand/estimation-batch/**
!hagrid/demand/estimation-batch/**/
!hagrid/demand/estimation-batch/**/*.ipynb
!hagrid/demand/estimation-batch/**/.gitkeep

analysis/hannover/notebooks/input

hagrid/sim-input
hagrid/routerCache
hagrid/logs*
hagrid/logs

hagrid/sim-output
hagrid/output

# input: ignore contents but keep folder structure via .gitkeep; README.md is the root marker
hagrid/input/**
!hagrid/input/**/
!hagrid/input/**/.gitkeep
!hagrid/input/README.md

# hagrid-output: ignore contents but keep folder structure via .gitkeep
hagrid/hagrid-output/**
!hagrid/hagrid-output/**/
!hagrid/hagrid-output/**/.gitkeep

# hagrid-matsim-output: ignore contents but keep folder structure via .gitkeep
hagrid/hagrid-matsim-output/**
!hagrid/hagrid-matsim-output/**/
!hagrid/hagrid-matsim-output/**/.gitkeep

analysis/hannover/notebooks/cache
analysis/hannover/notebooks/emission_maps
analysis/hannover/notebooks/emission_maps_cum

output/*
analysis/hannover/notebooks/*
!analysis/hannover/notebooks/*.py
!analysis/hannover/notebooks/*.ipynb
!.gitignore

# Exclude vs code settings
.vscode/

# Exclude target folder
/target

# Exclude Shapefiles and associated formats
*.shp
*.shx
*.dbf
*.prj
*.sbn
*.sbx
*.cpg
*.qpj
*.shp.xml
*.fix



# Temporary helper / analysis scripts
analysis_cp.txt
analyze_tw*.ps1

# Freight module generated output (sim + MATSim test output)
external/freight/output/
external/freight/test/output/

# MATSim integration-test output (MatsimTestUtils writes to <module>/test/output)
hagrid/test/output/

# Python bytecode caches (were tracked by accident until 2026-07-27)
__pycache__/
*.pyc

# Generated analysis pages (regenerated from the run output; not versioned)
analysis/**/*.html
# ...but the sweep board's Parcel entry point is SOURCE, not a generated page.
# Without this negation a clone cannot rebuild the board at all, while the rule
# above still keeps every 26-38 MB run dashboard out. bundle.html stays ignored
# via board/.gitignore - it is the build artifact, rebuilt via the README recipe.
!analysis/hannover/sweep/board/index.html

# Headless visual-check screenshots (regenerate with `node shot.cjs`)
analysis/hannover/sweep/board/shot_*.png

# Legacy Hannover figures (moved from the repo root 2026-09-17; regenerated, not versioned)
analysis/hannover/legacy-figures/*
!analysis/hannover/legacy-figures/.gitkeep

# Root-level run output (DRT_BASELINE etc.) — reproducible, not versioned
/hagrid-output/

# local-only working files (untracked on purpose)
SESSION_LOG.md
analysis/lausitz/paper-figures/

# generated by SimulationBatGenerator at runtime; the tracked example lives in runs/hannover/
hagrid/run_hagrid_sim.bat
